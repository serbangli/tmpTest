<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE subjectScheme PUBLIC "-//OASIS//DTD DITA Subject Scheme Map//EN" "subjectScheme.dtd">
<subjectScheme>
    <subjectHead>
        <subjectHeadMeta>
            <navtitle>CircleChat Subject Scheme Map</navtitle>
        </subjectHeadMeta>
    </subjectHead>
    <hasInstance>
        <subjectdef keys="audienceSbjKey">
            <topicmeta>
                <navtitle>Audience</navtitle>
            </topicmeta>
            <subjectdef keys="enduser">
                <topicmeta>
                    <navtitle>End User</navtitle>
                </topicmeta>
            </subjectdef>
            <subjectdef keys="administrator">
                <topicmeta>
                    <navtitle>Administrator</navtitle>
                </topicmeta>
            </subjectdef>
        </subjectdef>

        <subjectdef keys="topic-category">
            <topicmeta>
                <navtitle>Topics by Category</navtitle>
            </topicmeta>
            <subjectdef keys="getting-started">
                <topicmeta>
                    <navtitle>Getting Started</navtitle>
                </topicmeta>
            </subjectdef>
            <subjectdef keys="installation">
                <topicmeta>
                    <navtitle>Installation</navtitle>
                </topicmeta>
            </subjectdef>
            <subjectdef keys="ui">
                <topicmeta>
                    <navtitle>User Interface</navtitle>
                </topicmeta>
            </subjectdef>
            <subjectdef keys="account">
                <topicmeta>
                    <navtitle>Account Management</navtitle>
                </topicmeta>
            </subjectdef>
            <subjectdef keys="configuration">
                <topicmeta>
                    <navtitle>Configuration</navtitle>
                </topicmeta>
            </subjectdef>
            <subjectdef keys="reference">
                <topicmeta>
                    <navtitle>Reference</navtitle>
                </topicmeta>
            </subjectdef>
            <subjectdef keys="support">
                <topicmeta>
                    <navtitle>Support</navtitle>
                </topicmeta>
            </subjectdef>
        </subjectdef>
    </hasInstance>
    <enumerationdef>
        <attributedef name="audience"/>
        <subjectdef keyref="audienceSbjKey"/>
    </enumerationdef>
    <!--Reject all possible values for other profiling attributes-->
    <enumerationdef>
        <attributedef name="product"/>
        <subjectdef/>
    </enumerationdef>
    <enumerationdef>
        <attributedef name="platform"/>
        <subjectdef/>
    </enumerationdef>
    <enumerationdef>
        <attributedef name="props"/>
        <subjectdef/>
    </enumerationdef>
    <enumerationdef>
        <attributedef name="otherprops"/>
        <subjectdef/>
    </enumerationdef>
    <enumerationdef>
        <attributedef name="rev"/>
        <subjectdef/>
    </enumerationdef>
</subjectScheme>
